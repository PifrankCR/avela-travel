---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureIcon from '../components/FeatureIcon.astro';
import { allVillas } from '../data/all-villas';
import { villaImage } from '../lib/villa-images';
import ogZenith from '../assets/images/villas/zenith/DSC05695-HDR-Edit.jpg';

// Ocaso and Zenith used to be written out below as two handwritten sections
// with their own galleries. They are villa data now, so they come through the
// grid like the rest. Ocaso was unpublished on 2026-11-08 and is no longer in
// the collection at all; see src/data/avela-villas.ts.
const collection = allVillas;
---

<BaseLayout
  title="Luxury Villas in Nosara, Costa Rica | Avela Travel"
  description="Browse handpicked villas in Nosara: jungle retreats and ocean-view hilltop houses, each one walked by our local team before it goes on the list."
  image={ogZenith}
>

  <!-- Page header -->
  <div class="page-header">
    <div class="page-header-inner">
      <p class="eyebrow reveal">Nosara Villa Collection</p>
      <h1 class="reveal reveal-delay-1">
        Handpicked villas,<br />
        <em>seen in person</em>
      </h1>
      <p class="page-subtitle reveal reveal-delay-2">
        We do not list every villa in Nosara. We list the ones our local team has walked
        through and will put a guest in, and that meet our standard for design, condition,
        and service.
      </p>
    </div>
  </div>

  <!-- Curated villa collection, from src/data/all-villas.ts -->
  <section class="villa-collection section" id="collection">
    <div class="section-inner">
      <div class="collection-intro reveal">
        <p class="eyebrow">Curated collection</p>
        <h2>More villas, all of them walked</h2>
        <p class="collection-lede">
          Beyond our signature properties, we work with a curated selection of villas
          across Las Huacas, Guiones, and Pelada, from architectural showpieces by
          Studio Saxe to group-friendly retreats sleeping up to sixteen. Browse the
          collection, then tell us your dates and we'll narrow it to the perfect fit.
        </p>
      </div>

      <div class="collection-grid">
        {collection.map((villa) => (
          <a href={`/villas/${villa.slug}`} class="villa-card reveal">
            <div class="villa-card-img">
              <Image
                src={villaImage(villa.cover.src)}
                alt={villa.cover.alt}
                loading="lazy"
                decoding="async"
                widths={[400, 800]}
                sizes="(max-width: 700px) 95vw, 32vw"
              />
            </div>
            <div class="villa-card-body">
              <p class="eyebrow">{villa.eyebrow}</p>
              <h3>{villa.name}</h3>
              <p class="villa-card-tagline">{villa.tagline}</p>
              <div class="villa-card-stats">
                <span>{villa.bedrooms} BR</span>
                <span>·</span>
                <span>{villa.bathrooms} BA</span>
                {villa.guests && <span>·</span>}
                {villa.guests && <span>Sleeps {villa.guests}</span>}
              </div>
              <p class="villa-card-desc">{villa.shortDescription}</p>
              <span class="villa-card-cta">View details →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Concierge band -->
  <section class="concierge-band-full section" style="background: var(--green-deep);">
    <div class="section-inner concierge-inner reveal">
      <div class="concierge-copy">
        <p class="eyebrow">Go further</p>
        <h2>Add the full Avela experience</h2>
        <p>
          Book your villa and let us build everything around it: private chef, daily
          activities, airport transfers, and 24/7 support from our local team. The guests
          who choose the full Avela services consistently tell us it was the best decision they made.
        </p>
      </div>
      <div class="concierge-actions">
        <a href="/contact" class="btn-cream">Plan My Trip</a>
        <a href="/about" class="btn-cream-ghost">About Avela</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ─── Page Header ─── */
  .page-header {
    background: var(--dark);
    padding: 160px var(--gutter) clamp(60px, 8vw, 100px);
  }

  .page-header-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .page-header .eyebrow {
    margin-bottom: 1.25rem;
    color: var(--eyebrow-on-dark);
  }

  .page-header h1 {
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--warm-cream);
    margin-bottom: 1.5rem;
    line-height: 1.05;
  }

  .page-header h1 em {
    font-style: italic;
    color: var(--amber);
  }

  .page-subtitle {
    font-size: clamp(15px, 2vw, 17px);
    font-weight: 300;
    color: rgba(255, 241, 207, 0.55);
    max-width: 600px;
    line-height: 1.7;
  }

  /* ─── Concierge band ─── */
  .concierge-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .concierge-copy .eyebrow {
    margin-bottom: 1rem;
  }

  .concierge-copy h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    color: var(--warm-cream);
    margin-bottom: 1.25rem;
  }

  .concierge-copy p {
    font-size: 15px;
    font-weight: 300;
    line-height: 1.8;
    color: rgba(255, 241, 207, 0.55);
    max-width: 600px;
  }

  .concierge-actions {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex-shrink: 0;
  }

  .btn-cream {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 16px 36px;
    background: var(--warm-cream);
    color: var(--dark);
    transition: background 0.25s var(--ease-smooth), border-color 0.25s var(--ease-smooth), color 0.25s var(--ease-smooth), transform 0.16s var(--ease-out);
    white-space: nowrap;
    text-align: center;
  }

  .btn-cream:hover {
    background: var(--amber);
    color: var(--dark);
  }

  .btn-cream-ghost {
    display: inline-block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 15px 36px;
    border: 1px solid rgba(255, 241, 207, 0.25);
    color: rgba(255, 241, 207, 0.65);
    transition: background 0.25s var(--ease-smooth), border-color 0.25s var(--ease-smooth), color 0.25s var(--ease-smooth), transform 0.16s var(--ease-out);
    text-align: center;
  }

  .btn-cream-ghost:hover {
    border-color: var(--warm-cream);
    color: var(--warm-cream);
  }

  @media (max-width: 1024px) {
    .concierge-inner {
      grid-template-columns: 1fr;
    }
  }

  /* ─── Curated Collection Grid ─── */
  .villa-collection {
    padding-top: clamp(4rem, 8vw, 7rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
    background: var(--cream);
  }
  .collection-intro {
    max-width: 720px;
    margin-bottom: 3rem;
  }
  .collection-intro h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--green-deep);
    margin: 1rem 0 1.25rem;
    line-height: 1.1;
  }
  .collection-lede {
    font-size: 16px;
    line-height: 1.7;
    color: rgba(19, 18, 16, 0.65);
  }
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2.5rem;
  }
  .villa-card {
    display: flex;
    flex-direction: column;
    background: var(--warm-cream);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.5s var(--ease-smooth), box-shadow 0.5s var(--ease-smooth);
    border: 1px solid rgba(19, 18, 16, 0.06);
  }
  .villa-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 40px rgba(19, 18, 16, 0.1);
  }
  .villa-card-img {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--dark);
  }
  .villa-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease-smooth);
  }
  .villa-card:hover .villa-card-img img {
    transform: scale(1.05);
  }
  .villa-card-body {
    padding: 1.75rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .villa-card-body .eyebrow {
    margin-bottom: 0.5rem;
  }
  .villa-card-body h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1.15;
    color: var(--green-deep);
    margin-bottom: 0.35rem;
  }
  .villa-card-tagline {
    font-size: 14px;
    font-style: italic;
    color: rgba(19, 18, 16, 0.55);
    margin-bottom: 1rem;
  }
  .villa-card-stats {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 1rem;
  }
  .villa-card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: rgba(19, 18, 16, 0.7);
    margin-bottom: 1.25rem;
    flex: 1;
  }
  .villa-card-cta {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--green-deep);
  }
</style>
