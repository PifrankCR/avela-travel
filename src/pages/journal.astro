---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import raintreePool from '../assets/images/villas/raintree/01-view-sunset-infinity-pool.jpg';
import surferWalking from '../assets/images/journal/surfer-walking-golden-hour-playa-guiones.jpg';
import zenithCover from '../assets/images/zenith/DSC04830-HDR-Edit.jpg';
import ostionalTurtle from '../assets/images/journal/ostional-arribada-olive-ridley-turtle.jpg';
import expSurf from '../assets/images/experiences/surf.jpg';
import expOcean from '../assets/images/experiences/ocean.jpg';
import heroHowler from '../assets/images/journal/howler-monkey-nicoya-nosara-blue-zone.jpg';
import bestThingsCoast from '../assets/images/nosara/nicoya-coast-cove-reef-aerial-costa-rica.jpg';
import thingsToDoSurf from '../assets/images/experiences/surfer-action-golden-spray.jpg';

const heroBg = await getImage({ src: heroHowler, format: 'webp', width: 2400, quality: 86 });

// Placeholder posts. Replace with real content as it's published.
// Each entry should later have a corresponding /journal/<slug>.astro page.
const posts = [
  {
    slug: 'best-things-to-do-in-nosara',
    category: 'Guide',
    title: 'Best things to do in Nosara',
    date: 'June 2026',
    excerpt:
      'The activities we build most weeks around: surf, offshore fishing out of Garza, the pink island, the Ostional arribada, waterfalls, sunset cruises, yoga, and the art of doing nothing.',
    cover: thingsToDoSurf,
    coverAlt: 'A surfer carving a wave with golden backlit spray at Playa Guiones, Nosara, Costa Rica',
    author: 'Stacie',
  },
  {
    slug: '10-best-things-about-nosara',
    category: 'Guide',
    title: '10 best things about Nosara',
    date: 'June 2026',
    excerpt:
      'Ten honest reasons Nosara gets under your skin: a Blue Zone pace, year-round surf, the Ostional arribada, wildlife that comes to you, and a town that never let the chain hotels in.',
    cover: bestThingsCoast,
    coverAlt: 'Aerial view of the Nicoya coastline near Nosara with reef and turquoise Pacific water, Costa Rica',
    author: 'Jordanny',
  },
  {
    slug: 'a-week-with-the-marx-family',
    category: 'Trip recap',
    title: 'A week with the Marx family',
    date: 'December 2025',
    excerpt:
      'Eight nights at Raintree over Thanksgiving week 2025. How we built the week, what worked, and the small choices that made it.',
    cover: raintreePool,
    coverAlt: 'Sunset view from a luxury villa infinity pool overlooking the jungle, Nosara, Costa Rica',
    author: 'Stacie',
  },
  {
    slug: 'reading-playa-guiones',
    category: 'Surf',
    title: 'Reading Playa Guiones',
    date: 'June 2026',
    excerpt:
      'How to look at Nosara surf the way locals do. Swell windows, wind, tides, and the quiet rhythm of a year on one of the most consistent sand-bottom breaks on the planet.',
    cover: surferWalking,
    coverAlt: 'Lone surfer walking on golden sand at sunset at Playa Guiones, Nosara, Costa Rica',
    author: 'Jordanny',
  },
  {
    slug: 'a-week-in-nosara-without-a-resort',
    category: 'Guide',
    title: 'A week in Nosara, without a resort',
    date: 'June 2026',
    excerpt:
      'A seven-day Nosara itinerary built around a private villa, a private chef, and local operators we trust. Day by day, with the small details that make the difference.',
    cover: zenithCover,
    coverAlt: 'Villa Zenith infinity pool at dusk over the Nosara coastline, Costa Rica',
    author: 'Stacie',
  },
  {
    slug: 'ostional-arribada-nosara',
    category: 'Guide',
    title: 'Inside the Ostional arribada',
    date: 'June 2026',
    excerpt:
      'One of the largest sea turtle nesting events on the planet happens less than twenty minutes from Nosara. Here is how to see it, what the science actually says, and the rules that keep it possible.',
    cover: ostionalTurtle,
    coverAlt: 'Olive Ridley sea turtle on the black sand of Playa Ostional during an arribada, Nicoya Peninsula, Costa Rica',
    author: 'Jordanny',
  },
  {
    slug: 'when-to-visit-nosara',
    category: 'Guide',
    title: 'When to actually visit Nosara',
    date: 'See the guide',
    excerpt:
      'The honest seasonal breakdown. Dry season versus green season, surf swell windows, holiday surcharges, and the two weeks of the year locals consider the secret peak.',
    cover: expSurf,
    coverAlt: 'Surfer riding a clean Playa Guiones wave, Nosara, Costa Rica',
    author: 'Jordanny',
    href: '/guides/when-to-visit',
  },
  {
    slug: 'the-monkey-head-story',
    category: 'Story',
    title: 'How Monkey Head Adventures got two boats',
    date: 'Coming soon',
    excerpt:
      'The 27 ft Ticorette and the 32 ft Osprey, how each one was chosen, what they are built for, and how Garza Harbor became home base.',
    cover: expOcean,
    coverAlt: 'Monkey Head Adventures sportfishing boat on the Pacific off Nosara, Costa Rica',
    author: 'Jordanny',
    upcoming: true,
  },
];

const categories = ['All', 'Trip recap', 'Guide', 'Surf', 'Story', 'Press'];

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'The Avela Journal',
  description: 'Trip recaps, Nosara guides, and stories from the Avela Experience team.',
  url: 'https://avelatravel.com/journal',
};
---

<BaseLayout
  title="The Journal | Avela Travel | Nosara, Costa Rica"
  description="Trip recaps, Nosara guides, and stories from the Avela Experience team. Notes from inside a Blue Zone."
  schema={pageSchema}
>
  <!-- ─── HERO ─── -->
  <section class="journal-hero" style={`background-image: url(${heroBg.src})`}>
    <div class="journal-hero-inner">
      <p class="eyebrow">The Journal</p>
      <h1>
        Field notes from a <em>Blue Zone</em>
      </h1>
      <p class="hero-lede">
        Trip recaps, seasonal guides, partner stories, and the unfiltered local intel
        we share with our guests. New posts as the year unfolds.
      </p>
    </div>
  </section>

  <!-- ─── CATEGORY FILTER ─── -->
  <section class="journal-filter" aria-label="Filter posts by category">
    <div class="journal-filter-inner">
      <ul class="filter-list">
        {categories.map((cat, i) => (
          <li>
            <button
              type="button"
              class={`filter-chip ${i === 0 ? 'active' : ''}`}
              data-filter={cat}
            >
              {cat}
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── POSTS GRID ─── -->
  <section class="journal-grid-section">
    <div class="journal-grid-inner">
      <div class="journal-grid">
        {posts.map((post, i) => {
          const href = post.href ?? `/journal/${post.slug}`;
          const isUpcoming = post.upcoming === true;
          const CardTag = isUpcoming ? 'div' : 'a';
          const cardProps = isUpcoming
            ? { class: 'journal-card-link journal-card-link-disabled' }
            : { href, class: 'journal-card-link', 'aria-label': post.title };
          return (
            <article class="journal-card reveal" style={`--delay:${i * 100}ms`} data-category={post.category}>
              <CardTag {...cardProps}>
                <div class="journal-card-image">
                  <Image
                    src={post.cover}
                    alt={post.coverAlt}
                    loading="lazy"
                    decoding="async"
                    widths={[400, 800]}
                    sizes="(max-width: 700px) 95vw, 32vw"
                  />
                  <span class="journal-card-badge">{post.date}</span>
                </div>
                <div class="journal-card-body">
                  <p class="journal-card-cat">{post.category} · {post.author}</p>
                  <h2>{post.title}</h2>
                  <p class="journal-card-excerpt">{post.excerpt}</p>
                  <span class="journal-card-arrow">
                    {isUpcoming ? 'Coming soon' : 'Read note →'}
                  </span>
                </div>
              </CardTag>
            </article>
          );
        })}
      </div>

      <p class="journal-empty-note">
        More posts in the pipeline. Want them in your inbox?
        Subscribe via the footer or
        <a href="/contact">drop us a line</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── HERO ─── */
  .journal-hero {
    position: relative;
    background-color: var(--green-deep);
    background-position: center;
    background-size: cover;
    background-repeat: no-repeat;
    color: var(--warm-cream);
    padding: clamp(180px, 22vw, 280px) var(--gutter) clamp(90px, 14vw, 160px);
    text-align: center;
    min-height: 88vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .journal-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(19, 18, 16, 0.50) 0%, rgba(58, 79, 65, 0.55) 55%, rgba(19, 18, 16, 0.72) 100%);
    z-index: 0;
  }

  .journal-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    margin: 0 auto;
  }

  .journal-hero .eyebrow {
    color: var(--eyebrow-on-dark);
    margin-bottom: 2rem;
    display: inline-block;
    letter-spacing: 4px;
  }

  .journal-hero h1 {
    font-size: clamp(64px, 12vw, 180px);
    line-height: 0.92;
    margin-bottom: 2.5rem;
    letter-spacing: -0.02em;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  .journal-hero h1 em {
    font-style: italic;
    color: var(--amber);
  }

  .hero-lede {
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.7;
    color: rgba(255, 241, 207, 0.88);
    max-width: 620px;
    margin: 0 auto;
  }

  /* ─── FILTER ─── */
  .journal-filter {
    background: var(--cream);
    border-bottom: 1px solid rgba(19, 18, 16, 0.08);
    padding: 1.5rem var(--gutter);
  }

  .journal-filter-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .filter-list {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    padding: 0;
    margin: 0;
  }

  .filter-chip {
    background: transparent;
    border: 1px solid rgba(19, 18, 16, 0.14);
    color: rgba(19, 18, 16, 0.62);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 9px 18px;
    cursor: pointer;
    transition: background 0.25s var(--ease-smooth), border-color 0.25s var(--ease-smooth), color 0.25s var(--ease-smooth), transform 0.16s var(--ease-out);
  }

  .filter-chip:hover {
    border-color: var(--brown);
    color: var(--brown);
  }

  .filter-chip.active {
    background: var(--green-deep);
    color: var(--cream);
    border-color: var(--green-deep);
  }

  /* ─── POSTS GRID ─── */
  .journal-grid-section {
    background: var(--cream);
    padding: clamp(60px, 9vw, 100px) var(--gutter);
  }

  .journal-grid-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .journal-card {
    background: var(--cream);
    transition-delay: var(--delay, 0ms);
  }

  .journal-card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .journal-card-link-disabled {
    cursor: default;
    opacity: 0.72;
  }
  .journal-card-link-disabled .journal-card-arrow {
    color: rgba(19, 18, 16, 0.45);
    letter-spacing: 1.5px;
    text-transform: uppercase;
    font-size: 11px;
  }

  .journal-card-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    position: relative;
    margin-bottom: 1.25rem;
  }

  .journal-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease-smooth);
  }

  .journal-card:hover .journal-card-image img {
    transform: scale(1.04);
  }

  .journal-card-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    background: rgba(19, 18, 16, 0.78);
    color: var(--warm-cream);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    padding: 6px 10px;
    backdrop-filter: blur(4px);
  }

  .journal-card-body {
    padding: 0 0.25rem;
  }

  .journal-card-cat {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--brown);
    margin: 0 0 0.65rem;
  }

  .journal-card h2 {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 28px);
    line-height: 1.18;
    margin: 0 0 0.85rem;
    color: var(--dark);
  }

  .journal-card-excerpt {
    font-size: 14.5px;
    line-height: 1.6;
    color: rgba(19, 18, 16, 0.72);
    margin: 0 0 1rem;
  }

  .journal-card-arrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--green-deep);
    border-bottom: 1px solid currentColor;
    padding-bottom: 3px;
    transition: color 0.2s var(--ease-smooth);
  }

  .journal-card:hover .journal-card-arrow {
    color: var(--brown);
  }

  .journal-empty-note {
    text-align: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(15px, 1.5vw, 18px);
    color: rgba(19, 18, 16, 0.6);
    margin: 0;
  }

  .journal-empty-note a {
    color: var(--brown);
    border-bottom: 1px solid currentColor;
    margin-left: 0.25rem;
  }

  @media (max-width: 1000px) {
    .journal-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .journal-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Category filter
  const chips = document.querySelectorAll<HTMLButtonElement>('.filter-chip');
  const cards = document.querySelectorAll<HTMLElement>('.journal-card');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      cards.forEach((card) => {
        if (!filter || filter === 'All' || card.dataset.category === filter) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
