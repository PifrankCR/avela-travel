---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ospreyBoat from '../../assets/images/fishing/osprey-sportfishing-boat-offshore-nosara-costa-rica.jpg';
import marlinJump from '../../assets/images/fishing/marlin-jumping-off-nosara-coast-costa-rica.jpg';
import tunaCatch from '../../assets/images/fishing/yellowfin-tuna-catch-osprey-boat-nosara.jpg';
import anglersCatch from '../../assets/images/fishing/anglers-with-catch-osprey-boat-nosara.jpg';
import snapperCatch from '../../assets/images/fishing/snapper-catch-osprey-boat-nosara.jpg';

const title = 'Costa Rica Sportfishing Package | Avela Travel';
const description =
  'Five nights of offshore fishing in Nosara, Costa Rica, built around a private villa and our own 32ft boat. Three full days on the water, all meals included, bilingual crew. From $4,300 per angler.';

// Pricing tiers, plus IVA
const tiers = [
  { size: '4 anglers', pp: '$4,500', total: '$18,000' },
  { size: '6 anglers', pp: '$4,300', total: '$25,800' },
];

const included = [
  {
    heading: 'Transportation',
    items: [
      'Round-trip private transfers between Liberia (LIR) and Nosara (two vans)',
      'Daily transfers between the villa and Playa Garza for boat departures',
      'No domestic connection flight required, Liberia is the direct gateway',
    ],
  },
  {
    heading: 'Accommodation',
    items: [
      'Five nights of exclusive use at Villa Blanco, Casa Kaiman',
      '3,541 sq ft villa on Playa Guiones with private pool',
      '4 bedrooms: 1 master king ensuite with bathtub, 1 king ensuite, 1 queen ensuite, 1 room with 3 twin beds',
    ],
  },
  {
    heading: 'Meals',
    items: [
      'Welcome dinner at the villa on arrival',
      'Breakfast at the villa and lunch on the boat for each of the three fishing days',
      'Dinner at the villa with your chef on fishing nights',
      'One dinner out on your free day, covered, at a restaurant you pick from a list we send',
      'Breakfast on departure day',
    ],
  },
  {
    heading: 'Offshore fishing',
    items: [
      'Three full-day private excursions on our own 32ft offshore boat',
      'Departures from Playa Garza, ten minutes from the villa',
      'Top-of-the-line tackle and equipment, beers and refreshments on board',
      'Professional bilingual captain and crew (Monkey Head Adventures fleet)',
      'Catch professionally cleaned and filleted at the end of each day',
    ],
  },
  {
    heading: 'On the ground',
    items: [
      'Dedicated local Avela host throughout your stay',
      'Reservations, scheduling, and any in-stay requests handled for you',
    ],
  },
];

const notIncluded = [
  'International airfare',
  'Costa Rica fishing license (about $15 per angler, through INCOPESCA)',
  'Alcohol beyond the beers and refreshments included on the boat',
  'Gratuities for crew, drivers, and chef (see FAQ)',
  'Personal purchases',
];

const dayShape = [
  {
    day: 'Day 1',
    title: 'Arrival',
    items: [
      'Liberia (LIR) airport pickup, two private vans, roughly 2.5 hours to Nosara',
      'Settle into Villa Blanco, time to swim, walk the beach, or rest',
      'Welcome dinner at the villa',
    ],
  },
  {
    day: 'Day 2',
    title: 'Fishing day 1',
    items: [
      'Early breakfast at the villa',
      'Short drive to Playa Garza for departure',
      'Full day offshore on the 32ft boat, lunch on board',
      'Catch cleaned and filleted, dinner waiting at the villa',
    ],
  },
  {
    day: 'Day 3',
    title: 'Fishing day 2',
    items: [
      'Same rhythm as day 2, different water and different setups depending on conditions',
      'Target species shift by season: marlin and sailfish in peak winter, mahi and tuna year-round',
    ],
  },
  {
    day: 'Day 4',
    title: 'Free day',
    items: [
      'No fishing. Surf, spa, an ATV waterfall ride, or simply the pool',
      'Dinner out in Nosara, covered, at a restaurant you pick from a list we send',
    ],
  },
  {
    day: 'Day 5',
    title: 'Fishing day 3',
    items: [
      'Final day on the water, rested after the day off',
      'Catch cleaned and filleted one last time, last dinner at the villa',
    ],
  },
  {
    day: 'Day 6',
    title: 'Departure',
    items: [
      'Departure breakfast at the villa, pack at an easy pace',
      'Private transfer back to Liberia (LIR)',
    ],
  },
];

const differentiators = [
  {
    title: 'A private villa, not a lodge',
    body:
      'Most Costa Rica fishing packages put you in a hotel room with a shared dock and a buffet line. We give your group an entire 3,541 sq ft villa on Playa Guiones with a private pool, full kitchen, and four bedrooms.',
  },
  {
    title: 'Our own boat, our own captain',
    body:
      'The 32ft offshore vessel belongs to Monkey Head Adventures, our sister company at Garza harbor. No broker markup, no rotating charter crews. You fish all three days with the same captain: Alex Moreno, raised in Playa Garza and decorated on the international circuit.',
  },
  {
    title: 'Liberia direct',
    body:
      'You land in Liberia and drive straight to the villa. Most Costa Rica fishing operators route you through San Jose, which means a domestic connection and a 4:30 AM wake-up to make the next flight.',
  },
  {
    title: 'All meals included, including dinners',
    body:
      'Competitors at this price tier include breakfast and a boat lunch. We include dinner every night: the villa chef on fishing nights, a welcome dinner on arrival, and one covered night out on your free day at a Nosara restaurant you pick from a list we send.',
  },
  {
    title: 'Mindful fishing',
    body:
      'Catch-and-release for billfish is the default. Eating-fish like mahi and tuna get cleaned and filleted for the villa kitchen the same evening. Healthy fisheries are why we still have the trips we have.',
  },
];

const addOns = [
  'Additional fishing days, subject to availability',
  'Additional villa nights, subject to availability',
  'Private bartender evening at the villa, cocktails built around dinner',
  'Surf lessons with ISA-certified instructors',
  'ATV river and waterfall day with our local ATV partner',
  'Zipline canopy tour through the Nosara reserve',
  'In-villa massage and yoga sessions',
  'Sunset catamaran cruise',
  'Non-fishing companion rate, on request',
];

const faqs = [
  {
    q: 'What is the minimum group size?',
    a: 'Four anglers. The package is built around exclusive use of the villa and the boat, so we run it with a minimum of four to make the per-angler economics work.',
  },
  {
    q: 'When is the best fishing season?',
    a: 'Year-round fishing is excellent on this coast. Prime billfish season runs roughly December through April, when sailfish and marlin numbers peak. Mahi-mahi, yellowfin tuna, and rooster fish are reliable year-round.',
  },
  {
    q: 'How far offshore do we go?',
    a: 'Typical runs are 15 to 30 nautical miles depending on the day and the target species. The 32ft vessel handles open Pacific conditions comfortably.',
  },
  {
    q: 'What gratuities should we plan for?',
    a: 'Captain and crew gratuities start at about $200 per day, given directly to the captain at the end of each fishing day. Airport drivers run $10 to $20 per person. For the villa chef, plan about $50 per day. Bring cash.',
  },
  {
    q: 'Can we bring our catch home?',
    a: 'Eating fish are cleaned and filleted at the villa kitchen. If you want to fly with frozen filets, you are responsible for confirming your airline policy, bringing proper coolers and packaging, and any customs requirements at your destination. We can advise.',
  },
  {
    q: 'How does payment work?',
    a: 'A 50% deposit reserves your dates. The balance is due 90 days before arrival. Bookings made inside 90 days require full payment at booking. We accept bank wire and credit card payment links. All payments are subject to 13% Costa Rica VAT (IVA).',
  },
  {
    q: 'What if we have to cancel?',
    a: 'Deposits are non-refundable unless agreed in writing. Bookings paid in full inside the 90-day window are non-refundable. We strongly recommend comprehensive travel insurance for weather, medical, and travel-disruption coverage.',
  },
  {
    q: 'Do you take companions who do not fish?',
    a: 'Yes. We can quote a non-fishing companion rate on request. They get the villa, the meals, the transfers, and access to all the optional Nosara activities (surf, wellness, jungle, boat) while the anglers are on the water.',
  },
];

const pageSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TouristTrip',
      name: 'Costa Rica Offshore Sportfishing Package, Nosara',
      description,
      url: 'https://avelatravel.com/itineraries/fishing',
      touristType: ['Sportfishing', 'Offshore fishing', 'Luxury villa stay'],
      provider: { '@type': 'Organization', name: 'Avela Travel' },
      offers: tiers.map((t) => ({
        '@type': 'Offer',
        name: `${t.size}, five-night package`,
        price: t.pp.replace('$', '').replace(',', ''),
        priceCurrency: 'USD',
        description: `${t.pp} per angler at ${t.size}, totalling ${t.total} for the group. Plus 13% Costa Rica VAT.`,
      })),
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description} schema={pageSchema}>
  <!-- HERO -->
  <section class="fishing-hero">
    <div class="fishing-hero-inner">
      <p class="eyebrow">Signature package</p>
      <h1>
        Five nights of <em>offshore fishing</em>, built around a private villa in Nosara.
      </h1>
      <p class="fishing-hero-lede">
        Six days, five nights, three full days on the water, our own 32ft boat, all meals included.
        For groups of four to six anglers who want the trip done properly, without the lodge logistics.
      </p>
      <p class="fishing-hero-meta">
        <span>From $4,300 per angler</span>
        <span aria-hidden="true">·</span>
        <span>Plus 13% IVA</span>
        <span aria-hidden="true">·</span>
        <span>4 to 6 anglers</span>
      </p>
      <div class="fishing-hero-actions">
        <a href="/contact?trip=fishing" class="btn-primary">Inquire about dates</a>
        <a href="#what-included" class="btn-ghost">See what is included</a>
      </div>
    </div>
  </section>

  <!-- HERO IMAGE -->
  <figure class="fishing-hero-figure">
    <Image
      src={ospreyBoat}
      alt="The Osprey, our 32ft sportfishing boat, trolling offshore on the Pacific near Nosara, Costa Rica"
      loading="eager"
      decoding="async"
      widths={[768, 1280, 2000]}
      sizes="(max-width: 1500px) 100vw, 1500px"
    />
  </figure>

  <!-- AT A GLANCE -->
  <section class="fishing-glance">
    <div class="fishing-glance-inner">
      <div class="glance-item">
        <span class="glance-num">6</span>
        <span class="glance-label">Days, five nights at Villa Blanco</span>
      </div>
      <div class="glance-item">
        <span class="glance-num">3</span>
        <span class="glance-label">Full days offshore on a private 32ft vessel</span>
      </div>
      <div class="glance-item">
        <span class="glance-num">4 to 6</span>
        <span class="glance-label">Anglers, exclusive use of villa and boat</span>
      </div>
      <div class="glance-item">
        <span class="glance-num">12 mo</span>
        <span class="glance-label">Year-round fishing, peak billfish Dec to Apr</span>
      </div>
    </div>
  </section>

  <!-- THE TRIP IN WORDS -->
  <section class="fishing-section">
    <div class="fishing-section-inner">
      <p class="eyebrow">The trip</p>
      <h2>A real fishing trip, run from a real villa</h2>
      <p>
        Most Costa Rica fishing packages are built around a lodge: a shared dock, hotel-style rooms,
        and a buffet schedule. We built this package differently. Your group has exclusive use of a
        3,541 sq ft villa on Playa Guiones with a private pool, full kitchen, four bedrooms, and the
        kind of quiet you only get a few hundred meters from the surf.
      </p>
      <p>
        The boat is ours. The 32ft offshore vessel belongs to <strong>Monkey Head Adventures</strong>,
        our sister company out of Garza harbor, ten minutes south of the villa. The same bilingual
        captain and mate run your three days. There is no broker, no rotating charter crew, and no
        guessing at quality from one day to the next.
      </p>
      <p>
        Off the water, your group has the full Avela network: surf lessons, in-villa massage,
        chef-led tastings, ATV waterfall days, sunset cruises. We coordinate it all from inside
        Nosara so your free time becomes the trip your group will talk about, not the trip you
        white-knuckled through.
      </p>
    </div>
  </section>

  <!-- CAPTAIN -->
  <section class="fishing-section fishing-section-dark">
    <div class="fishing-section-inner">
      <p class="eyebrow">Your captain</p>
      <h2>Alex Moreno, <em>captain and angler</em></h2>
      <p>
        Alex was raised in Playa Garza, the beach your boat leaves from every morning. He is a
        Certified International Boat Captain whose career has run through international waters:
        he was part of the first-place team at the Puerto Calero Marlin Cup in the Canary Islands,
        which qualified him for the 2026 Offshore World Championship in Costa Rica, and he has won
        Garza's own Ship of Fools tournament several times.
      </p>
      <p>
        What that means for your group: international tournament instincts, applied to water he
        has read since childhood. All three of your fishing days run with Alex and his mate.
      </p>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="fishing-section">
    <div class="fishing-section-inner">
      <p class="eyebrow">From the boat</p>
      <h2>What the water gives up</h2>
      <ul class="fishing-gallery" role="list">
        <li>
          <Image src={marlinJump}
            alt="Marlin jumping clear of the water off the Nosara coast, hills behind"
            loading="lazy" decoding="async" widths={[300, 600]} sizes="(max-width: 800px) 48vw, 24vw" />
        </li>
        <li>
          <Image src={tunaCatch}
            alt="Angler holding a yellowfin tuna aboard the Osprey at sunrise"
            loading="lazy" decoding="async" widths={[300, 600]} sizes="(max-width: 800px) 48vw, 24vw" />
        </li>
        <li>
          <Image src={anglersCatch}
            alt="Two anglers with their catch on the deck of the Osprey"
            loading="lazy" decoding="async" widths={[300, 600]} sizes="(max-width: 800px) 48vw, 24vw" />
        </li>
        <li>
          <Image src={snapperCatch}
            alt="Angler holding a large snapper aboard the Osprey off Nosara"
            loading="lazy" decoding="async" widths={[300, 600]} sizes="(max-width: 800px) 48vw, 24vw" />
        </li>
      </ul>
    </div>
  </section>

  <!-- WHAT IS INCLUDED -->
  <section class="fishing-section fishing-section-light" id="what-included">
    <div class="fishing-section-inner">
      <p class="eyebrow">Included</p>
      <h2>Everything in one package</h2>
      <p class="section-lede">
        Built so that the only cash you handle on the trip is gratuities. Everything else is paid
        before you fly, with no add-on surprises waiting at the lodge.
      </p>

      <div class="fishing-includes-grid">
        {included.map((group) => (
          <div class="fishing-includes-block">
            <h3>{group.heading}</h3>
            <ul>
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <details class="fishing-not-included">
        <summary>What is not included</summary>
        <ul>
          {notIncluded.map((item) => <li>{item}</li>)}
        </ul>
      </details>
    </div>
  </section>

  <!-- DAY BY DAY -->
  <section class="fishing-section">
    <div class="fishing-section-inner">
      <p class="eyebrow">Day by day</p>
      <h2>How the week shapes up</h2>
      <p class="section-lede">
        A standard shape, but flexible. We adjust to weather windows, your group's pace, and the
        species running in your dates.
      </p>

      <div class="fishing-days">
        {dayShape.map((d) => (
          <article class="fishing-day">
            <div class="fishing-day-head">
              <span class="fishing-day-label">{d.day}</span>
              <h3>{d.title}</h3>
            </div>
            <ul>
              {d.items.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DIFFERENTIATORS -->
  <section class="fishing-section fishing-section-dark">
    <div class="fishing-section-inner">
      <p class="eyebrow">Why this trip</p>
      <h2>Where we are different</h2>
      <div class="fishing-diff-grid">
        {differentiators.map((d) => (
          <div class="fishing-diff-card">
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="fishing-section fishing-section-light" id="pricing">
    <div class="fishing-section-inner">
      <p class="eyebrow">Pricing</p>
      <h2>Per-angler pricing scales with the group</h2>
      <p class="section-lede">
        Two tiers based on group size. Larger groups bring the per-person rate down. All prices in
        USD and subject to 13% Costa Rica VAT.
      </p>

      <div class="fishing-pricing-grid">
        {tiers.map((t) => (
          <div class="fishing-price-card">
            <p class="fishing-price-size">{t.size}</p>
            <p class="fishing-price-pp">
              <span class="fishing-price-num"><span class="usd">$</span>{t.pp.replace('$', '')}</span>
              <span class="fishing-price-unit">per angler</span>
            </p>
            <p class="fishing-price-total">Group total <span class="usd">$</span>{t.total.replace('$', '')}</p>
            <p class="fishing-price-tax">Plus 13% IVA</p>
          </div>
        ))}
      </div>

      <div class="fishing-price-terms">
        <p>
          <strong>Booking:</strong> 50% deposit secures your dates. Balance due 90 days before
          arrival. Bookings made inside 90 days require full payment at booking and are non-refundable.
        </p>
        <p>
          <strong>Payment:</strong> Bank wire transfer or credit card via secure payment link.
        </p>
        <p>
          <strong>Cancellation:</strong> Deposits are non-refundable unless agreed in writing. We
          strongly recommend comprehensive travel insurance.
        </p>
      </div>
    </div>
  </section>

  <!-- ADD-ONS -->
  <section class="fishing-section">
    <div class="fishing-section-inner">
      <p class="eyebrow">Optional</p>
      <h2>Add-ons your group can layer in</h2>
      <p class="section-lede">
        Useful for non-fishing companions traveling with the group, or to extend the trip.
        Pricing on request.
      </p>
      <ul class="fishing-addons">
        {addOns.map((a) => <li>{a}</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="fishing-section fishing-section-light">
    <div class="fishing-section-inner">
      <p class="eyebrow">Frequently asked</p>
      <h2>Practical questions</h2>
      <div class="fishing-faq">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="fishing-cta">
    <div class="fishing-cta-inner">
      <p class="eyebrow">Ready to plan</p>
      <h2>Tell us your dates and your group size. <em>We will reply with a tailored proposal.</em></h2>
      <p>
        We respond personally within 24 hours. Dates fill earliest for the December through April
        billfish window, so the further out you can plan, the more flexibility we have.
      </p>
      <div class="fishing-cta-actions">
        <a href="/contact?trip=fishing" class="btn-primary">Inquire about dates</a>
        <a href="https://wa.me/50687297620" target="_blank" rel="noopener noreferrer" class="btn-ghost">WhatsApp Stacie</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .fishing-hero {
    background: var(--green-deep);
    color: var(--warm-cream);
    padding: clamp(140px, 16vw, 200px) var(--gutter) clamp(50px, 7vw, 80px);
    text-align: center;
  }
  .fishing-hero-inner {
    max-width: 880px;
    margin: 0 auto;
  }
  .fishing-hero .eyebrow {
    color: var(--amber);
    margin-bottom: 1.5rem;
    display: inline-block;
  }
  .fishing-hero h1 {
    font-size: clamp(40px, 5.5vw, 78px);
    line-height: 1.05;
    margin-bottom: 1.5rem;
  }
  .fishing-hero h1 em {
    font-style: italic;
    color: var(--amber);
  }
  .fishing-hero-lede {
    font-size: clamp(16px, 1.7vw, 20px);
    line-height: 1.65;
    color: rgba(255, 241, 207, 0.82);
    margin-bottom: 1.5rem;
  }
  .fishing-hero-meta {
    font-family: var(--font-body);
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: rgba(255, 241, 207, 0.6);
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.65rem;
    margin-bottom: 2rem;
  }
  .fishing-hero-actions {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  .btn-primary, .btn-ghost {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 14px 28px;
    transition: all 0.2s var(--ease-smooth);
  }
  .btn-primary {
    background: var(--amber);
    color: var(--cream);
  }
  .btn-primary:hover { background: var(--amber-deep); }
  .btn-ghost {
    border: 1px solid rgba(255, 241, 207, 0.45);
    color: var(--warm-cream);
  }
  .btn-ghost:hover { background: rgba(255, 241, 207, 0.08); }

  /* HERO IMAGE (placeholder, swap before launch) */
  .fishing-hero-figure {
    background: var(--cream);
    margin: 0;
  }
  .fishing-hero-figure img {
    width: 100%;
    max-width: 1500px;
    height: auto;
    display: block;
    margin: -40px auto 0;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* AT A GLANCE */
  .fishing-glance {
    background: var(--cream);
    padding: clamp(40px, 6vw, 70px) var(--gutter);
  }
  .fishing-glance-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    text-align: center;
  }
  .glance-num {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    color: var(--brown);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .glance-label {
    display: block;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 1.55;
    color: rgba(19, 18, 16, 0.7);
  }
  @media (max-width: 800px) {
    .fishing-glance-inner { grid-template-columns: repeat(2, 1fr); }
  }

  /* SECTIONS */
  .fishing-section {
    background: var(--cream);
    padding: clamp(60px, 9vw, 110px) var(--gutter);
  }
  .fishing-section-light {
    background: #faf1da;
  }
  .fishing-section-dark {
    background: var(--dark);
    color: var(--warm-cream);
  }
  .fishing-section-inner {
    max-width: 1000px;
    margin: 0 auto;
  }
  .fishing-section h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.5vw, 44px);
    line-height: 1.1;
    margin: 0 0 1rem;
    color: var(--dark);
  }
  .fishing-section-dark h2 { color: var(--warm-cream); }
  .fishing-section-dark h2 em {
    font-style: italic;
    color: var(--amber);
