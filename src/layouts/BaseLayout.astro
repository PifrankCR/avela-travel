---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyFoliage from '../components/StickyFoliage.astro';
import defaultOgSrc from '../assets/images/ocaso/ocaso-1.jpg';

interface Props {
  title: string;
  description?: string;
  image?: ImageMetadata | string;
  schema?: object;
}

const {
  title,
  description = 'Avela Travel: the Avela Experience in Nosara, Costa Rica. Handpicked villas, private chefs, surf sessions, ocean adventures, and full itinerary planning.',
  image = defaultOgSrc,
  schema,
} = Astro.props;

const ogImage =
  typeof image === 'string'
    ? image
    : (await getImage({ src: image, format: 'jpeg', width: 1200 })).src;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/images/avela-logo.png" />

    <!-- No-JS fallback: reveal animations must never hide content -->
    <noscript><style>.reveal{opacity:1 !important;transform:none !important;}</style></noscript>

    <!-- Structured data -->
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}

    <!-- Cloudflare Web Analytics -->
    <script
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "65ab85aff431429383216b23cb3c1acd"}'
    ></script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>

    <!-- Sticky inquiry bar -->
    <aside class="sticky-inquiry" id="sticky-inquiry" aria-label="Plan your Nosara trip" hidden>
      <StickyFoliage />
      <div class="sticky-inquiry-inner">
        <div class="sticky-inquiry-copy">
          <span class="sticky-inquiry-eyebrow">Tell us about your trip</span>
          <span class="sticky-inquiry-tagline">We reply within a day. The proposal follows a short call.</span>
        </div>
        <div class="sticky-inquiry-actions">
          <a href="/contact" class="sticky-inquiry-cta">Plan my trip</a>
          <button type="button" class="sticky-inquiry-close" aria-label="Dismiss">×</button>
        </div>
      </div>
    </aside>

    <Footer />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // Sticky inquiry bar: show after 35% scroll, hide on /contact.
      // Once dismissed it stays down for the rest of this page view; a
      // refresh brings it back (in-memory flag, no persistence).
      (() => {
        const bar = document.getElementById('sticky-inquiry');
        if (!bar) return;
        if (location.pathname.startsWith('/contact')) return;

        let dismissed = false;
        bar.hidden = false;
        const closeBtn = bar.querySelector('.sticky-inquiry-close');
        closeBtn?.addEventListener('click', () => {
          dismissed = true;
          bar.classList.remove('visible');
        });

        let ticking = false;
        const onScroll = () => {
          if (dismissed || ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            const doc = document.documentElement;
            const scrolled = (doc.scrollTop) / (doc.scrollHeight - doc.clientHeight);
            if (scrolled > 0.35) bar.classList.add('visible');
            else bar.classList.remove('visible');
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      })();
    </script>
  </body>
</html>
